{
  "manifest_version": 2,

  "name": "Toshiba Legacy Remote",
  "version": "1.0",

  "permissions": [
    "storage",
    "http://*/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}